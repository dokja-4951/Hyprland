// Fixed for Waybar 0.15+ on plain Hyprland (distro-specific modules removed). Original: HANCORE-linux/waybar-themes
{
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "spacing": 0,
  "height": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-left": [
    "clock",
    "custom/separator",
    "custom/updatespacman",
    "tray",
    "custom/separator",
    "custom/windowpill"
  ],
  "modules-right": [
    "custom/vidcon",
    "group/right2",
    "group/right"
  ],
  "group/right2": {
    "orientation": "inherit",
    "modules": [
      "mpris"
    ]
  },
  "group/right": {
    "orientation": "inherit",
    "modules": [
      "backlight",
      "bluetooth",
      "network",
      "pulseaudio",
      "memory",
      "cpu",
      "battery"
    ]
  },
  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{icon}",
    "show-special": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": {
      "*": 6
    },
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X"
    }
  },
  "custom/separator": {
    "format": "|",
    "tooltip": false
  },
  "custom/windowpill": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/1.8-window_pill.py",
    "return-type": "json",
    "restart-interval": 1,
    "align": 0,
    "justify": "left"
  },
  "custom/updatespacman": {
    "format": "{}{icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": " 󰏖",
      "updated": ""
    },
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --no-zero-output"
  },
  "cpu": {
    "interval": 2,
    "format": "<span size='8pt' color='#df6124'>CPU </span>{usage}%",
    "on-click": "kitty -e btop"
  },
  "memory": {
    "interval": 2,
    "format": "<span size='8pt' color='#df6124'>MEM </span>{percentage}%",
    "on-click": "kitty -e btop"
  },
  "clock": {
    "format": "{:%H:%M - %a, %d}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode"
    }
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "<span size='8pt' color='#df6124'>NET </span>{signalStrength}%",
    "format-ethernet": "<span size='8pt' color='#df6124'>NET </span>{bandwidthDownBytes:=}",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "kitty -e nmtui"
  },
  "battery": {
    "format": "<span size='8pt' color='#df6124'>BAT </span>{capacity}%",
    "format-discharging": "<span size='8pt' color='#df6124'>BAT </span>{capacity}%",
    "format-charging": "<span size='8pt' color='#df6124'>BAT_c </span>{capacity}%",
    "format-plugged": "<span size='8pt' color='#df6124'>BAT_p </span>{capacity}%",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "format-full": "<span size='8pt' color='#df6124'>BAT_f </span>{capacity}%",
    "tooltip-format-discharging": "{timeTo}",
    "tooltip-format-charging": "{timeTo}",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "<span size='8pt' color='#df6124'>BT </span>{status} {num_connections}",
    "format-disabled": "<span size='8pt' color='#df6124'>BT </span>{status}",
    "format-connected": "<span size='8pt' color='#df6124'>BT </span>{num_connections}",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "kitty -e bluetoothctl"
  },
  "pulseaudio": {
    "format": "<span size='8pt' color='#df6124'>VOL </span>{volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "backlight": {
    "rotate": 0,
    "format": "<span size='8pt' color='#df6124'>BL </span>{percent}%",
    "tooltip-format": "🌕 {percent}%",
    "format-icons": [
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠"
    ]
  },
  "tray": {
    "icon-size": 15,
    "spacing": 5
  },
  "mpris": {
    "format": " {artist} - {title}",
    "format-paused": "<span color='grey'>{status_icon}  {title}</span>",
    "max-length": 40,
    "player-icons": {
      "default": "⏸",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "󰝛"
    },
    "ignored-players": [
      "firefox",
      "chromium",
      "brave"
    ]
  },
  "custom/vidcon": {
    "format": "",
    "tooltip-format": "Video converter\nQueue: ~/Videos/convert_queue",
    "on-click": "kitty --hold -e $HOME/.config/waybar/scripts/vidcon"
  }
}
